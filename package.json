{
  "name": "mtg-rgb-hd",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rimraf dist",
    "lint": "tsc --noEmit && oxlint",
    "export:composite": "tsx scripts/export-composite.ts",
    "lint:fix": "oxlint --fix",
    "data:cities": "tsx scripts/build-cities.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^6.1.1",
    "express": "^5.2.1",
    "file-saver": "^2.0.5",
    "gifenc": "^1.0.3",
    "jszip": "^3.10.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/file-saver": "^2.0.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.5.6",
    "esbuild": "^0.28.2",
    "oxlint": "^1.82.0",
    "playwright": "^1.63.0",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~7.0.2",
    "vite": "^8.3.0"
  }
}
