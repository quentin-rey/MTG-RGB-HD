{
  "name": "mtg-rgb-hd",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=build/server.cjs",
    "start": "node build/server.cjs",
    "clean": "rimraf dist build",
    "lint": "tsc --noEmit && oxlint",
    "export:composite": "tsx scripts/export-composite.ts",
    "lint:fix": "oxlint --fix",
    "data:cities": "tsx scripts/build-cities.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.2.1",
    "express": "^5.3.0",
    "file-saver": "^2.0.5",
    "gifenc": "^1.0.3",
    "jszip": "^3.10.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/file-saver": "^2.0.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.92.0",
    "playwright": "^1.65.0",
    "rimraf": "^6.1.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
